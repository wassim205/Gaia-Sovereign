// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ThirdPartyAppStatus {
  ACTIVE
  BLOCKED
}

enum ConsentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum VaultCategory {
  PROFILE
  CONTACT
  DOCUMENT
  CREDENTIAL
  NOTE
  OTHER
}

model User {
  id                  String        @id @default(uuid())
  username            String        @unique
  email               String        @unique
  password            String        @map("password_hash")
  role                UserRole      @default(USER)
  status              Int           @default(1)
  encryptedMasterKey  String?       @map("encrypted_master_key")
  emailVerifiedAt     DateTime?     @map("email_verified_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  deletedAt           DateTime?     @map("deleted_at")
  
  vaultEntries        VaultEntry[]
  thirdPartyApps      ThirdPartyApp[]
  
  @@map("users")
}

model ThirdPartyApp {
  id                String              @id @default(uuid())
  ownerId           String              @map("owner_id")
  name              String              @db.VarChar(255)
  description       String?             @db.Text
  clientId          String              @unique @map("client_id") @db.VarChar(64)
  secretHash        String              @map("secret_hash") @db.VarChar(255)
  status            ThirdPartyAppStatus @default(ACTIVE)
  redirectUris      String[]            @map("redirect_uris")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  secretRotatedAt   DateTime?           @map("secret_rotated_at")

  owner             User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  consentRequests   ConsentRequest[]

  @@index([ownerId])
  @@index([status])
  @@map("third_party_apps")
}

model ConsentRequest {
  id              String               @id @default(uuid())
  appId           String               @map("app_id")
  redirectUri     String               @map("redirect_uri")
  requestedFields String[]             @map("requested_fields")
  status          ConsentRequestStatus @default(PENDING)
  expiresAt       DateTime             @map("expires_at")
  state           String?              @db.VarChar(255)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  app             ThirdPartyApp        @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@index([status])
  @@index([expiresAt])
  @@map("consent_requests")
}

model VaultEntry {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  title       String         @db.VarChar(255)
  category    VaultCategory  @default(OTHER)
  description String?        @db.Text
  isFavorite  Boolean        @default(false) @map("is_favorite")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fields      VaultField[]
  
  @@index([userId])
  @@index([category])
  @@index([userId, category])
  @@map("vault_entries")
}

model VaultField {
  id              String      @id @default(uuid())
  vaultEntryId    String      @map("vault_entry_id")
  fieldKey        String      @db.VarChar(100)
  encryptedValue  String      @map("encrypted_value") @db.Text
  fieldType       String      @default("text") @map("field_type") @db.VarChar(50)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  
  vaultEntry      VaultEntry  @relation(fields: [vaultEntryId], references: [id], onDelete: Cascade)
  
  @@index([vaultEntryId])
  @@index([fieldKey])
  @@map("vault_fields")
}